[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/credits_menu.gd" id="1_credits"]
[ext_resource type="Theme" path="res://resources/themes/vcr_ui_theme.tres" id="2_theme"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.05, 0.08, 0.11, 0.98)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.18, 0.74, 0.92, 0.62)
corner_radius_top_left = 14
corner_radius_top_right = 14
corner_radius_bottom_right = 14
corner_radius_bottom_left = 14
shadow_color = Color(0, 0, 0, 0.35)
shadow_size = 10

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card"]
bg_color = Color(0.08, 0.12, 0.16, 0.98)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.15, 0.64, 0.84, 0.42)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button"]
bg_color = Color(0.08, 0.12, 0.16, 0.98)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.15, 0.64, 0.84, 0.55)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button_hover"]
bg_color = Color(0.11, 0.18, 0.23, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.96, 0.77, 0.24, 0.85)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[node name="CreditsMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_credits")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 0
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0, 0, 0, 0.56)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 0
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(480, 0)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 22
theme_override_constants/margin_top = 22
theme_override_constants/margin_right = 22
theme_override_constants/margin_bottom = 22

[node name="VBox" type="VBoxContainer" parent="Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Eyebrow" type="Label" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.77, 0.24, 0.9)
theme_override_font_sizes/font_size = 13
text = "ATTRIBUTION"
horizontal_alignment = 1

[node name="Title" type="Label" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Credits"
horizontal_alignment = 1

[node name="Hint" type="Label" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.78, 0.84, 0.92)
theme_override_font_sizes/font_size = 15
text = "Verified third-party sources and authored assets currently used in the build."
horizontal_alignment = 1
autowrap_mode = 2

[node name="GeneratedCard" type="PanelContainer" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_card")

[node name="Margin" type="MarginContainer" parent="Center/Panel/Margin/VBox/GeneratedCard"]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 12

[node name="Label" type="Label" parent="Center/Panel/Margin/VBox/GeneratedCard/Margin"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
autowrap_mode = 2
text = "PixelLab MCP\nGenerated player, enemy, environment, and pickup art for Aces & Augments.\nhttps://api.pixellab.ai/mcp"

[node name="CardsCard" type="PanelContainer" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_card")

[node name="Margin" type="MarginContainer" parent="Center/Panel/Margin/VBox/CardsCard"]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 12

[node name="Label" type="Label" parent="Center/Panel/Margin/VBox/CardsCard/Margin"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
autowrap_mode = 2
text = "Playing Cards Pack by Kenney\nLicense: CC0 1.0\nhttps://kenney.nl/assets/playing-cards-pack"

[node name="FontCard" type="PanelContainer" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_card")

[node name="Margin" type="MarginContainer" parent="Center/Panel/Margin/VBox/FontCard"]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 12

[node name="Label" type="Label" parent="Center/Panel/Margin/VBox/FontCard/Margin"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
autowrap_mode = 2
text = "VCR OSD Mono by Riciery Leal\nSource: DaFont\nhttps://www.dafont.com/vcr-osd-mono.font"

[node name="AudioCard" type="PanelContainer" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_card")

[node name="Margin" type="MarginContainer" parent="Center/Panel/Margin/VBox/AudioCard"]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 12

[node name="Label" type="Label" parent="Center/Panel/Margin/VBox/AudioCard/Margin"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.72, 0.78, 0.84, 0.92)
autowrap_mode = 2
text = "Audio for the current build is original procedural audio authored for Aces & Augments. If sourced replacements are adopted later, this screen will be updated with their attribution."

[node name="CloseButton" type="Button" parent="Center/Panel/Margin/VBox"]
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
theme_override_font_sizes/font_size = 17
theme_override_styles/normal = SubResource("StyleBoxFlat_button")
theme_override_styles/pressed = SubResource("StyleBoxFlat_button_hover")
theme_override_styles/hover = SubResource("StyleBoxFlat_button_hover")
theme_override_styles/focus = SubResource("StyleBoxFlat_button_hover")
text = "Back"
